[Unit]
Description=Codex Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/codex-tg
EnvironmentFile=/home/your-user/.config/codex-telegram/.env
ExecStart=/usr/bin/node /path/to/codex-tg/dist/index.js
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
